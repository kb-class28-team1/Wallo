<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.chat.mapper.ConsumptionAnalysisResultMapper">

    <insert id="insert"
            parameterType="com.wallo.chat.dto.ConsumptionAnalysisResultDto$SaveCommand">
        INSERT INTO CONSUMPTION_ANALYSIS_RESULTS (
            user_id,
            request_message,
            calculated_result,
            ai_response
        ) VALUES (
            #{userId},
            #{requestMessage},
            #{calculatedResultJson},
            #{aiResponse}
        )
    </insert>

</mapper>
