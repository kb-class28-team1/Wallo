<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.pointshop.mapper.PointShopMapper">

    <!-- USERS 테이블의 포인트 잔액을 조회함. -->
    <select id="findPointBalance" resultType="java.lang.Integer">
        SELECT point
        FROM USERS
        WHERE id = #{userId}
    </select>

    <!-- 삭제되지 않은 보관함 상품만 최근 획득 순으로 조회함. -->
    <resultMap id="pointShopInventoryItemResultMap"
               type="com.wallo.pointshop.domain.PointShopInventoryItem">
        <id property="inventoryId" column="inventory_id" />
        <result property="itemName" column="item_name" />
        <result property="status" column="status" />
        <result property="acquiredAt" column="acquired_at" />
    </resultMap>

    <select id="findInventoryItems" resultMap="pointShopInventoryItemResultMap">
        SELECT
            id AS inventory_id,
            item_name,
            status,
            acquired_at
        FROM USER_INVENTORY
        WHERE user_id = #{userId}
          AND deleted_at IS NULL
        ORDER BY acquired_at DESC, id DESC
    </select>
</mapper>
