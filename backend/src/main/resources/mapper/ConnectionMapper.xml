<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.asset.mapper.ConnectionMapper">
    <insert id="insertConnections" parameterType="java.util.List">
        INSERT IGNORE INTO CONNECTIONS (
            USER_ID,
            INSTITUTION_ID,
            LOGIN_TYPE,
            LOGIN_ID,
            LOGIN_PASSWORD,
            STATUS,
            CONNECTED_AT
        )
        VALUES
        <foreach collection="connections" item="connection" separator=",">
            (
                #{userId},
                #{connection.institutionId},
                #{loginType},
                #{loginId},
                #{loginPassword},
                #{connection.status},
                NOW()
            )
        </foreach>
    </insert>
</mapper>

