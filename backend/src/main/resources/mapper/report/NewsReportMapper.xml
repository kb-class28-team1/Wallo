<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.report.mapper.NewsReportMapper">

    <!-- DB 컬럼명과 NewsReport Java 필드명을 명시적으로 연결한다. -->
    <resultMap id="newsReportResultMap" type="com.wallo.report.domain.NewsReport">
        <id property="reportId" column="report_id" />
        <result property="newsId" column="news_id" />
        <result property="summary" column="summary" />
        <result property="eventDescription" column="event_description" />
        <result property="cause" column="cause" />
        <result property="socialImpact" column="social_impact" />
        <result property="userImpact" column="user_impact" />
        <result property="responseStrategy" column="response_strategy" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <select id="findByNewsId" resultMap="newsReportResultMap">
        SELECT
            report_id,
            news_id,
            summary,
            event_description,
            cause,
            social_impact,
            user_impact,
            response_strategy,
            created_at,
            updated_at
        FROM news_report
        WHERE news_id = #{newsId}
    </select>

    <!-- useGeneratedKeys: INSERT 뒤 DB가 만든 news_report.report_id를 NewsReport 객체에 반영한다. -->
    <insert id="insert"
            parameterType="com.wallo.report.domain.NewsReport"
            useGeneratedKeys="true"
            keyProperty="reportId">
        INSERT INTO news_report (
            news_id,
            summary,
            event_description,
            cause,
            social_impact,
            user_impact,
            response_strategy
        ) VALUES (
            #{newsId},
            #{summary},
            #{eventDescription},
            #{cause},
            #{socialImpact},
            #{userImpact},
            #{responseStrategy}
        )
    </insert>
</mapper>
