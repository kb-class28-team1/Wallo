<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.report.term.mapper.NewsTermMapper">

    <delete id="deleteByNewsId">
        DELETE FROM news_term
        WHERE news_id = #{newsId}
    </delete>

    <!-- news_term은 (news_id, term_id) 복합 PK다. deleteByNewsId를 먼저 호출해 기존 매칭 결과를
         지운 뒤 이 batch INSERT를 실행하므로, 같은 뉴스에 재실행해도 PK 충돌 없이 안전하다. -->
    <insert id="batchInsert">
        INSERT INTO news_term (news_id, term_id)
        VALUES
        <foreach collection="termIds" item="termId" separator=",">
            (#{newsId}, #{termId})
        </foreach>
    </insert>

    <resultMap id="matchedFinancialTermResultMap" type="com.wallo.report.term.domain.FinancialTerm">
        <id property="termId" column="term_id" />
        <result property="termName" column="term_name" />
        <result property="description" column="description" />
        <result property="shortDefinition" column="short_definition" />
        <result property="source" column="source" />
    </resultMap>

    <!-- news_term과 financial_term을 term_id로 조인해 뉴스에 매칭된 용어의 이름/정의/출처를 함께 가져온다. -->
    <select id="findTermsByNewsId" resultMap="matchedFinancialTermResultMap">
        SELECT
            ft.term_id,
            ft.term_name,
            ft.description,
            ft.short_definition,
            ft.source
        FROM news_term nt
        JOIN financial_term ft ON nt.term_id = ft.term_id
        WHERE nt.news_id = #{newsId}
    </select>
</mapper>
