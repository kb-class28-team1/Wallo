<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.report.mapper.NewsMapper">

    <!-- DB 컬럼명과 News Java 필드명을 명시적으로 연결한다. -->
    <resultMap id="newsResultMap" type="com.wallo.report.domain.News">
        <id property="newsId" column="news_id" />
        <result property="title" column="title" />
        <result property="content" column="content" />
        <result property="source" column="source" />
        <result property="url" column="url" />
        <result property="category" column="category" />
        <result property="publishedAt" column="published_at" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <!-- useGeneratedKeys: INSERT 뒤 DB가 만든 news.news_id를 News 객체에 반영한다. -->
    <insert id="insertNews"
            parameterType="com.wallo.report.domain.News"
            useGeneratedKeys="true"
            keyProperty="newsId">
        INSERT INTO news (
            title,
            content,
            source,
            url,
            category,
            published_at
        ) VALUES (
            #{title},
            #{content},
            #{source},
            #{url},
            #{category},
            #{publishedAt}
        )
    </insert>

    <select id="existsByUrl" resultType="int">
        SELECT COUNT(*)
        FROM news
        WHERE url = #{url}
    </select>

    <select id="findById" resultMap="newsResultMap">
        SELECT
            news_id,
            title,
            content,
            source,
            url,
            category,
            published_at,
            created_at,
            updated_at
        FROM news
        WHERE news_id = #{newsId}
    </select>

    <select id="findLatest" resultMap="newsResultMap">
        SELECT
            news_id,
            title,
            content,
            source,
            url,
            category,
            published_at,
            created_at,
            updated_at
        FROM news
        ORDER BY published_at DESC
        LIMIT #{limit}
    </select>

    <!-- DB 컬럼명과 NewsReportListItem Java 필드명을 명시적으로 연결한다. -->
    <resultMap id="newsReportListItemResultMap" type="com.wallo.report.domain.NewsReportListItem">
        <id property="newsId" column="news_id" />
        <result property="title" column="title" />
        <result property="category" column="category" />
        <result property="source" column="source" />
        <result property="url" column="url" />
        <result property="publishedAt" column="published_at" />
        <result property="summary" column="summary" />
        <result property="analyzed" column="analyzed" />
    </resultMap>

    <!--
        news_report가 이미 생성된 뉴스만 노출한다(INNER JOIN). 목록에서 기사를 클릭하면 곧바로
        AI 리포트가 보여야 하므로, 아직 리포트가 없는 뉴스는 여기서부터 제외한다 — 그런 뉴스는
        크롤링 직후 FinancialReportGenerationScheduler가 백그라운드에서 채운 뒤에야 노출된다.
        단일 쿼리라 N+1이 발생하지 않는다. published_at은 현재 NOT NULL이지만, 향후 컬럼 제약이
        바뀌더라도 null이 뒤로 가도록 안전하게 정렬한다.
    -->
    <select id="findAllWithReportSummary" resultMap="newsReportListItemResultMap">
        SELECT
            n.news_id,
            n.title,
            n.category,
            n.source,
            n.url,
            n.published_at,
            nr.summary,
            true AS analyzed
        FROM news n
        JOIN news_report nr ON n.news_id = nr.news_id
        WHERE COALESCE(n.published_at, n.created_at) >= DATE_SUB(CURDATE(), INTERVAL 2 DAY)
        ORDER BY n.published_at IS NULL, n.published_at DESC, n.news_id DESC
    </select>

    <!--
        news_report가 없는 뉴스만 골라 게시일시 최신순으로 limit개 반환한다. 금융 리포트 자동 생성 스케줄러 전용.
        본문이 없거나(NULL) 공백뿐인 뉴스는 애초에 대상에서 제외한다 — 그런 뉴스는 항상
        REPORT_CONTENT_EMPTY로 스킵될 뿐이라, 걸러내지 않으면 매 스케줄마다 계속 뽑혀서
        정상 대상의 자리를 차지하게 된다. 뉴스 조회 이후 삭제되거나 본문이 지워지는 경쟁 상황은
        이 필터로 막을 수 없으므로, FinancialReportGenerationScheduler의 REPORT_CONTENT_EMPTY
        스킵 처리는 최종 방어선으로 그대로 유지한다.
    -->
    <select id="findNewsIdsWithoutReport" resultType="long">
        SELECT n.news_id
        FROM news n
        LEFT JOIN news_report nr ON n.news_id = nr.news_id
        WHERE nr.news_id IS NULL
          AND n.content IS NOT NULL
          AND TRIM(n.content) &lt;&gt; ''
        ORDER BY n.published_at IS NULL, n.published_at DESC, n.news_id DESC
        LIMIT #{limit}
    </select>

    <delete id="deleteNewsTermsBeforePublishedAt">
        DELETE nt
        FROM news_term nt
        JOIN news n ON nt.news_id = n.news_id
        WHERE COALESCE(n.published_at, n.created_at) &lt; #{cutoff}
    </delete>

    <delete id="deleteNewsReportsBeforePublishedAt">
        DELETE nr
        FROM news_report nr
        JOIN news n ON nr.news_id = n.news_id
        WHERE COALESCE(n.published_at, n.created_at) &lt; #{cutoff}
    </delete>

    <delete id="deleteNewsBeforePublishedAt">
        DELETE FROM news
        WHERE COALESCE(published_at, created_at) &lt; #{cutoff}
    </delete>
</mapper>
