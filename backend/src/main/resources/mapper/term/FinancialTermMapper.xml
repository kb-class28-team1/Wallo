<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wallo.term.mapper.FinancialTermMapper">

    <resultMap id="financialTermResultMap" type="com.wallo.term.domain.FinancialTerm">
        <id property="termId" column="term_id" />
        <result property="termName" column="term_name" />
        <result property="description" column="description" />
        <result property="source" column="source" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <select id="findAll" resultMap="financialTermResultMap">
        SELECT
            term_id,
            term_name,
            description,
            source,
            created_at
        FROM financial_term
    </select>
</mapper>
